rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // EmeraldOS Gold Shell needs public read access to know which version folder to boot.
    match /system/emeraldGoldLatest {
      allow read: if true;
      // Recommended: only allow staff/admin writes through your real admin workflow.
      allow write: if request.auth != null;
    }

    match /emeraldOSUsers/{username}/{document=**} {
      // If you later use Firebase Auth, replace this with request.auth token checks.
      allow read, write: if request.auth != null;
    }
  }
}
